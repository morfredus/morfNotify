# Service systemd pour morfNotify.
#
# Le binaire et sa configuration sont INSTALLES dans un dossier fixe (par defaut
# /opt/morfnotify), independant du clone git : deplacer/renommer le depot (ou une
# synchro Syncthing) ne casse pas le service. install-service.sh remplace
# __RUN_USER__ et __APP_DIR__.

[Unit]
Description=morfNotify - point de diffusion des notifications de l'ecosysteme
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/morfnotify --config __CONFIG_DIR__/morfnotify.json
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Durcissement (etape D de l'hygiene, 2026-10-10) : le systeme de fichiers est en
# lecture seule pour le service, sauf son dossier de logs. morfNotify n'ecrit rien
# d'autre : sa config reste sous /etc (lue seulement) et il n'a pas d'etat.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# Cree /var/log/morfnotify, possede par User= et inscriptible malgre ProtectSystem :
# c'est la place du fichier de la destination « log » (avant, /var/log/morfnotify.log,
# un dossier root que le service ne pouvait pas ecrire).
LogsDirectory=morfnotify

[Install]
WantedBy=multi-user.target
